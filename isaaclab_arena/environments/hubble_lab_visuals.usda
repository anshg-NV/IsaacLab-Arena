#usda 1.0
(
    defaultPrim = "Lab"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lab"
{
    def "Looks"
    {
        def Material "BlackCloth"
        {
            token outputs:mdl:surface.connect = </Lab/Looks/BlackCloth/WovenSheen.outputs:out>
            token outputs:surface.connect = </Lab/Looks/BlackCloth/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.009, 0.004)
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Lab/Looks/BlackCloth/Normal.outputs:rgb>
                float inputs:roughness = 0.7
                float inputs:roughness.connect = </Lab/Looks/BlackCloth/Roughness.outputs:r>
                color3f inputs:specularColor = (0.0044, 0.0044, 0.0044)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "TileScale"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Lab/Looks/BlackCloth/UV.outputs:result>
                float2 inputs:scale = (69.44444, 69.44444)
                float2 outputs:result
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.25, -0.25, -1, 0)
                asset inputs:file = @/home/anshg/worktrees/lane-29/agentic_design/lane29/assets/cloth/cloth_normal.png@
                float4 inputs:scale = (0.5, 0.5, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Lab/Looks/BlackCloth/TileScale.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }

            def Shader "Roughness"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @/home/anshg/worktrees/lane-29/agentic_design/lane29/assets/cloth/cloth_roughness.png@
                float4 inputs:scale = (0.7, 0.7, 0.7, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Lab/Looks/BlackCloth/TileScale.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
            }

            def Shader "WovenSheen"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @/home/anshg/miniconda3/envs/isaaclab_robomimic_3_0/lib/python3.12/site-packages/isaacsim/kit/mdl/core/Base/OmniSurface.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniSurface"
                color3f inputs:diffuse_reflection_color = (0.012, 0.009, 0.004)
                float inputs:diffuse_reflection_roughness = 0.5
                float inputs:diffuse_reflection_weight = 1
                asset inputs:geometry_normal_image = @/home/anshg/worktrees/lane-29/agentic_design/lane29/assets/cloth/cloth_normal.png@
                float inputs:geometry_normal_roughness_strength = 0.3
                float inputs:geometry_normal_strength = 0.25
                float inputs:specular_reflection_ior = 1.5
                float inputs:specular_reflection_roughness = 0.7
                float inputs:specular_reflection_weight = 0.1
                color3f inputs:specular_retro_reflection_color = (0.12, 0.12, 0.12)
                float inputs:specular_retro_reflection_roughness = 0.75
                float inputs:specular_retro_reflection_weight = 0.04
                float inputs:uvw_s_scale = 69.44444
                float inputs:uvw_t_scale = 69.44444
                token outputs:out
            }
        }

        def Material "BlackPaint"
